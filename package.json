{
  "name": "digixsquad",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "contract:lint": "pnpm --filter @digixsquad/contract lint",
    "contract:gen": "pnpm --filter @digixsquad/api-client generate",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yaml,yml}\""
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prettier": "^3.6.2",
    "turbo": "^2.6.0",
    "typescript": "^5.9.0"
  }
}
