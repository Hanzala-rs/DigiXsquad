# ───────── Shared ─────────
APP_ENV=development
PUBLIC_SITE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000/api/v1

# ───────── Web (apps/web) ─────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA   # Cloudflare test key
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ───────── API (apps/api) ─────────
DATABASE_URL=postgresql+asyncpg://digix:digix@localhost:5432/digixsquad
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
CORS_ORIGINS=http://localhost:3000
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA   # Cloudflare test secret

# S3-compatible storage (MinIO locally, Cloudflare R2 in cloud)
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=digixsquad-private
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
UPLOAD_MAX_MB=10

# Email
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="DigixSquad <no-reply@digixsquad.com>"
SALES_NOTIFY_EMAIL=sales@digixsquad.com

# WhatsApp Cloud API (optional in v1)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Monitoring
SENTRY_DSN=
